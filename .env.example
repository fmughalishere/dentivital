# ---------------------------------------------------------------------------
# Dentivital — environment variables. Copy to `.env.local` and fill in.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store currency (ISO code). Everything — prices in the database, the site
# and Stripe — uses this. Changing it does NOT convert existing prices.
NEXT_PUBLIC_CURRENCY=USD

# --- Database --------------------------------------------------------------
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dentivital

# --- Auth ------------------------------------------------------------------
# Any long random string. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Emails listed here are promoted to admin automatically on sign-up/sign-in
ADMIN_EMAILS=admin@dentivital.com

# --- Google Sign-In (optional but recommended) -----------------------------
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorised JavaScript origin: http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From:  stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Cloudinary (admin product image uploads) ------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
